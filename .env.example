# Dental RCM Suite - configuration template.
#
# Copy to .env and fill in. Nothing here is a real value; .env is gitignored and
# must stay that way.

# -- Database -----------------------------------------------------------------
DB_SERVER=127.0.0.1
DB_PORT=1433
DB_NAME=dental_rcm

# The application login. Give it read/write on the application tables and
# NOTHING MORE. In particular it must not be a member of db_owner: the
# row-level security predicate exempts database owners, so connecting as one
# silently disables database-enforced tenant isolation.
DB_USER=dental_rcm_app
DB_PASSWORD=

# A separate, higher-privileged login used only by db/migrate.js to apply DDL.
# Migrations need db_owner; the application login must not have it. Leave unset
# to reuse DB_USER (fine for a single-tenant trial, not for shared hosting).
MIGRATE_DB_USER=
MIGRATE_DB_PASSWORD=

# Set APP_DB_PASSWORD and migration 903 creates the restricted login named
# above, then DB_USER/DB_PASSWORD should point at it. Leave it empty and the
# login is not created: the application filter still applies, but the database
# security policy is inert for whatever login the API uses, because that login
# will be a database owner.
APP_DB_USER=dental_rcm_app
APP_DB_PASSWORD=

# -- Session signing ----------------------------------------------------------
# Signs the session tokens issued at login. The API refuses to verify or issue a
# token without it - it will not fall back to an insecure default.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=
SESSION_TTL=12h

# Minutes of inactivity before a session is closed (HIPAA 164.312(a)(2)(iii)).
SESSION_TIMEOUT_MINUTES=30

# -- Field-level encryption ---------------------------------------------------
# Encrypts designated PHI fields at rest, AES-256-GCM. Exactly 64 hex
# characters (32 bytes). Generate with:  openssl rand -hex 32
#
# Losing this key means losing the data it protects. Back it up somewhere other
# than this machine, and rotate it deliberately rather than casually.
FIELD_ENCRYPTION_KEY=

# -- Server -------------------------------------------------------------------
NODE_ENV=development
PORT=8080

# Where the browser app is served from. Always IPv4: on Windows, "localhost"
# resolves to ::1 first and fails against an IPv4-only listener.
CORS_ORIGIN=http://127.0.0.1:4200

# Shared key for the websocket handshake and service-to-service calls. Not a
# user credential and never sent to a browser.
API_KEY=

# -- Cross-tenant administration (optional, off by default) -------------------
# If you run a tenant for your own organisation and want its administrators to
# see across all client tenants, set its customer_id here.
#
# Leave it unset unless you mean it. Whoever owns this tenant id can read every
# tenant's data and bypasses product entitlement checks. Unset, empty or
# non-numeric disables the concept entirely - there is no default.
VENDOR_CUSTOMER_ID=

# Pins the deployment to a single tenant by slug, for a single-customer install.
CLIENT_TENANT_SLUG=

# -- Single sign-on (optional) ------------------------------------------------
# Set these to accept tokens from an OIDC identity provider instead of local
# passwords. Multi-factor authentication then becomes the provider's
# responsibility - the local credential path has none.
#
# Works with any compliant provider. No provider is privileged in the code.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=

# -- Bootstrap account --------------------------------------------------------
# The first administrator, created by db/migrations/901_bootstrap_admin.sql.
# It is created with a known password and must change it at first sign-in; the
# API refuses every other route until it does.
BOOTSTRAP_ADMIN_EMAIL=admin@localhost

# Leave empty to use the published default ("changeme-on-first-login"), which is
# safe only because the account can do nothing but change its own password. Set
# it to any string of 12 characters or more and the runner hashes that instead,
# so the published default never exists in your database.
BOOTSTRAP_ADMIN_PASSWORD=

# Which classes of migration may load data: `clean` is reference data only.
# `demo` additionally admits anything tagged `@data: demo`. This distribution
# ships none, so the two are equivalent until you add some.
DATA_PROFILE=clean

# -- Optional integrations ----------------------------------------------------
# Where claim documents are stored. 'local' writes to STORAGE_PATH on disk;
# 'azure_blob' needs the two AZURE_STORAGE_* values below.
STORAGE_PROVIDER=local
STORAGE_PATH=./uploads
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=

# Encrypts stored documents at rest. Separate from FIELD_ENCRYPTION_KEY so the
# two can be rotated independently.
FILE_ENCRYPTION_KEY=

# Apache Superset embedding for custom dashboards. All three must be set or the
# embedding route returns 503 - there is deliberately no default credential.
SUPERSET_URL=
SUPERSET_ADMIN_USER=
SUPERSET_ADMIN_PASS=
SUPERSET_SSO_JWT_SECRET=

# Outbound email for scheduled InsightFlow reports. Unset means no email is
# sent; nothing is queued for later.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Local Ollama instance for the AI-assisted narrative and strategy features.
# Unset means those features degrade to their non-AI behaviour.
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# Redis, for job queues and rate limiting across more than one API instance.
# Leave empty to run single-instance with in-memory state.
REDIS_URL=

# -- docker compose only ------------------------------------------------------
# Read by docker-compose.yml, not by the application.
#
# The sa password for the throwaway SQL Server container. Required by
# `docker compose up`; irrelevant if you point DB_SERVER at your own instance.
DB_SA_PASSWORD=

# Host ports. Change these if something already listens on the defaults - the
# ports inside the containers are fixed and do not move with them.
WEB_PORT=4200
API_PORT_HOST=8080
DB_PORT_HOST=1433
