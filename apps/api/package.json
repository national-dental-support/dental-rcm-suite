{
  "name": "dental-rcm-suite-api",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "description": "Dental RCM Suite - API server",
  "license": "Apache-2.0",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc",
    "start": "cross-env NODE_ENV=production dotenv -e .env node dist/src/index.js",
    "dev": "cross-env NODE_ENV=development nodemon --watch src --ext ts --exec \"ts-node src/index.ts\"",
    "test": "cross-env NODE_ENV=test JWT_SECRET=test-only-secret jest --runInBand",
    "test:watch": "cross-env NODE_ENV=test dotenv -e .env jest --watch",
    "lint": "npx eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "migrate": "node ../../db/migrate.js",
    "migrate:status": "node ../../db/migrate.js --status",
    "migrate:dry": "node ../../db/migrate.js --dry-run",
    "seed:remediation-carcs": "cross-env NODE_ENV=production dotenv -e .env ts-node src/scripts/seed-remediation-carcs.ts"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.29.1",
    "@noble/post-quantum": "^0.2.1",
    "@trpc/server": "^10.44.1",
    "@types/axios": "^0.14.4",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.11",
    "@types/winston": "^2.4.4",
    "apexcharts": "^3.54.1",
    "axios": "^1.16.1",
    "chalk": "^4.1.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "date-fns": "^4.1.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.2.0",
    "fast-csv": "^5.0.2",
    "fast-xml-parser": "^5.5.9",
    "follow-redirects": "^1.16.2",
    "helmet": "^8.1.0",
    "http-proxy-middleware": "^3.0.5",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mssql": "^12.3.1",
    "multer": "^2.0.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.3.1",
    "socket.io": "^4.7.5",
    "winston": "^3.15.0",
    "zod": "^4.3.6",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6"
  },
  "_overrides_note": [
    "Every override here is bounded to a major. An open-ended '>=x' resolves to",
    "the newest version in existence, which is how two of these broke the build:",
    "'cookie: >=0.7.2' pulled an ESM-only major, and 'path-to-regexp: >=0.1.13'",
    "pulled 9.x into express 4, whose router then threw 'pathRegexp is not a",
    "function' at startup. Neither failed a test, because both are startup-time",
    "and resolution-time faults. Keep these bounded.",
    "Removed as dead config: tar, lodash and basic-ftp are absent from the tree,",
    "and 'lodash: >=4.18.0' could never be satisfied at all - 4.17.21 is the",
    "latest lodash there is - so it would have broken any future install that",
    "pulled lodash in."
  ],
  "overrides": {
    "cookie": "^1.0.2",
    "braces": "^3.0.3",
    "cross-spawn": "^7.0.6",
    "minimatch": "^11.0.3",
    "flatted": "^3.4.2",
    "brace-expansion": "^5.0.12",
    "handlebars": "^4.7.9",
    "picomatch": "^4.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/cookie-parser": "^1.4.5",
    "@types/cors": "^2.8.15",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/mongodb": "^4.0.6",
    "@types/morgan": "^1.9.7",
    "@types/mssql": "^9.1.2",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.5.6",
    "@types/pg": "^8.20.0",
    "@types/socket.io": "^3.0.2",
    "@types/ssh2": "^1.15.0",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^6.4.1",
    "@typescript-eslint/parser": "^6.4.1",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^7.3.0",
    "eslint": "^8.48.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2",
    "@types/bcryptjs": "^2.4.6"
  }
}
