{
  "name": "dental-rcm-suite-web",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "cross-env NG_BUILD_MAX_WORKERS=2 node --max_old_space_size=8192 ./node_modules/@angular/cli/bin/ng serve --proxy-config proxy.conf.json --host 127.0.0.1",
    "build": "cross-env NODE_OPTIONS=--max_old_space_size=12288 NG_BUILD_MAX_WORKERS=2 ng build --configuration production --source-map=false --verbose",
    "watch": "cross-env NODE_OPTIONS=--max_old_space_size=4096 NG_BUILD_MAX_WORKERS=2 ng build --watch --configuration development",
    "test": "cross-env NODE_OPTIONS=--max_old_space_size=4096 NG_BUILD_MAX_WORKERS=2 ng test",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "serve:ssr:rcm-angular": "node dist/rcm-angular/server/server.mjs",
    "clean": "rimraf node_modules dist && npx ng cache clean",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix"
  },
  "dependencies": {
    "@angular/animations": "^21.2.13",
    "@angular/cdk": "^21.2.11",
    "@angular/common": "^21.2.13",
    "@angular/compiler": "^21.2.13",
    "@angular/core": "^21.2.13",
    "@angular/forms": "^21.2.13",
    "@angular/localize": "^21.2.13",
    "@angular/material": "^21.2.11",
    "@angular/platform-browser": "^21.2.13",
    "@angular/platform-browser-dynamic": "^21.2.13",
    "@angular/router": "^21.2.13",
    "@azure/storage-blob": "^12.28.0",
    "apexcharts": "^3.54.1",
    "cross-env": "^10.1.0",
    "exceljs": "^4.4.0",
    "express": "^4.18.4",
    "ng-apexcharts": "1.8.0",
    "rxjs": "~7.8.1",
    "socket.io-client": "^4.8.3",
    "tslib": "^2.6.2",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular-builders/jest": "^21.0.3",
    "@angular-eslint/builder": "^21.4.0",
    "@angular-eslint/eslint-plugin": "^21.4.0",
    "@angular-eslint/eslint-plugin-template": "^21.4.0",
    "@angular-eslint/schematics": "^21.4.0",
    "@angular-eslint/template-parser": "^21.4.0",
    "@angular/build": "^21.2.11",
    "@angular/cli": "^21.2.11",
    "@angular/compiler-cli": "^21.2.13",
    "@playwright/test": "^1.44.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.2.5",
    "@types/quill": "^1.3.10",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "baseline-browser-mapping": "^2.9.19",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "jest-extended": "^7.0.0",
    "jest-jasmine2": "^29.7.0",
    "jest-preset-angular": "^16.1.5",
    "madge": "^7.0.0",
    "typescript": "~5.9.3"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "overrides": {
    "ng-apexcharts": "1.8.0",
    "uuid": "^11.1.1",
    "minimatch": "^11.0.3",
    "glob": "^14.0.2"
  },
  "license": "Apache-2.0",
  "description": "Dental RCM Suite - web application"
}
