# Two upstream peer ranges in this tree are stricter than what actually works:
#   - @angular-builders/jest@21 declares a peer on jest@^30 while this project
#     still runs jest@29 with the jest-jasmine2 runner, which the specs depend on.
# The installed tree is exercised by the unit suite and the production build, so
# the conflict is in the declared metadata rather than in behaviour. Resolving it
# properly means migrating off jest-jasmine2; tracked as an open task.
legacy-peer-deps=true
